# Copy to .env.local and fill in. On Vercel, set these in Project Settings -> Environment Variables.

# Database. Locally a SQLite file; in production your Turso URL (libsql://...).
DATABASE_URL="file:./prisma/dev.db"
# Turso only (leave empty for a local file).
DATABASE_AUTH_TOKEN=""

# Login. Use a long password (a passphrase of 4+ random words is good).
APP_PASSWORD=""
# Signs the login cookie. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""
