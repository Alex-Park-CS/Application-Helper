generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// `status` and `source` are plain strings: the allowed values live in
// src/lib/applications/constants.ts and are enforced by Zod on every write.
// Date-only fields are stored as UTC midnight.
model Application {
  id             Int       @id @default(autoincrement())
  company        String
  roleTitle      String
  jobUrl         String?
  location       String?
  source         String    @default("Other")
  status         String    @default("Saved")
  dateFound      DateTime?
  dateApplied    DateTime?
  followUpDate   DateTime?
  resumeVersion  String?
  contactName    String?
  contactInfo    String?
  jobDescription String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}
